{
  "name": "echo-party",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-04",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/connect"]},
  "durable_objects": {"bindings": [{"name": "PARTY", "class_name": "PartyDirectory"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PartyDirectory"]}]
}
